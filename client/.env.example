# API base URL (no trailing slash).
# Default (recommended for dev): leave empty to go through Vite's proxy to FastAPI on :8888.
# Same origin as the UI → no CORS issues, and the auth cookie also reaches the /ws WebSocket.
VITE_API_URL=
# Or call the API directly (CORS on the server must include your exact page origin, e.g. http://127.0.0.1:5173):
# VITE_API_URL=http://127.0.0.1:8888
