# ─── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. Install one driver: `pymysql` for MySQL, `psycopg[binary]` for Postgres.
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/banner_generator

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# 10080 = 7 days. Lower for tighter security; higher = less re-login friction.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Session cookie (browser-side) ────────────────────────────────────────────
# Dev (HTTP, same host):       COOKIE_SECURE=false  COOKIE_SAMESITE=lax
# Prod same-origin HTTPS:      COOKIE_SECURE=true   COOKIE_SAMESITE=lax
# Prod cross-origin HTTPS SPA: COOKIE_SECURE=true   COOKIE_SAMESITE=none
# (SameSite=none REQUIRES Secure=true — auth.py auto-corrects and logs an error.)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set when API and UI live on subdomains of the same parent (e.g. api.example.com
# + app.example.com → COOKIE_DOMAIN=.example.com). Leave empty for host-only cookies.
COOKIE_DOMAIN=

# ─── CORS (extra origins beyond the built-in localhost dev set) ───────────────
# Comma-separated. Required when COOKIE_SAMESITE=none.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ─── AI / video providers ─────────────────────────────────────────────────────
OPENAI_API_KEY=
HEYGEN_API_KEY=
ELEVENLABS_API_KEY=
D_ID_API_KEY=

# ─── Render pipeline tunables ─────────────────────────────────────────────────
# Optional FFmpeg binary override (defaults to "ffmpeg" on PATH).
UGC_FFMPEG_BINARY=
# Cap concurrent Remotion renders inside the video worker.
MAX_CONCURRENT_RENDERS=2
# Remotion soft timeout for one UGC caption render (milliseconds).
UGC_RENDER_TIMEOUT_MS=180000
# Python-side soft timeout for the Node /render-ugc HTTP call (seconds).
VIDEO_ENGINE_RENDER_UGC_TIMEOUT=240

# ─── Frontend (client/.env, mirrored here for reference) ──────────────────────
# Leave empty in dev to use the Vite proxy. In prod, point at the API origin.
VITE_API_URL=
